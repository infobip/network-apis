<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app does not track users across apps/websites owned by other companies. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- multiplatform-settings uses NSUserDefaults to persist the Authorization
			     header credential, access token, client credentials and the debug flag
			     (see SettingsRepository). CA92.1 = the app
			     accesses its own user defaults, not an App Group's or another
			     process's. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- The Kotlin/Native runtime calls mach_absolute_time() for monotonic timing;
			     no app code touches it. Because the Shared framework is linked statically
			     (shared/build.gradle.kts: isStatic = true), Apple does not pick up a
			     framework-level manifest for it and the app bundle must declare it here.
			     35F9.1 = measuring elapsed time between in-app events. It forbids sending
			     the boot time off-device, which the app never does.
			     See https://kotlinlang.org/docs/multiplatform/multiplatform-privacy-manifest.html -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>

	<!-- Collected data types.
	     NOTE: Apple publishes a fixed enumeration of data types and there is NO
	     "Credentials" value. Passwords and session tokens must be declared as
	     NSPrivacyCollectedDataTypeOtherDataTypes.
	     Keep this list in sync with the App Store Connect privacy questionnaire and
	     with the Google Play Data safety form: a mismatch is a metadata rejection. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- The "Username" entered on the Username & Password tab, sent to the enterprise backend's
			     token endpoint as the client_id form parameter. Declared as UserID rather than
			     EmailAddress because a client id is not necessarily an email.
			     Linked: it identifies the backend client in use. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- The MSISDN entered for verification, sent to the enterprise backend.
			     Not linked to an identity and never used for tracking. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Authentication secrets: the "Password" entered on the Username & Password tab (sent
			     as the client_secret form parameter), the resulting access token,
			     and the credential entered on the Authorization header tab. They travel in
			     the Authorization header as "Basic <credential>" or "Bearer <token>". Apple has no dedicated credentials
			     category, so these belong under Other Data Types. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
